generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum UserStatus {
  ACTIVE
  PENDING
  DISABLED
}

enum CodePurpose {
  EMAIL_VERIFY
  INSTRUCTOR_INVITE
  PASSWORD_RESET
}

model User {
  id                 String     @id @default(uuid())
  email              String     @unique
  name               String
  passwordHash       String?
  role               UserRole   @default(STUDENT)
  status             UserStatus @default(PENDING)
  googleId           String?    @unique
  emailVerified      Boolean    @default(false)
  mustChangePassword Boolean    @default(false)
  avatarUrl          String?
  phone              String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  verificationCodes VerificationCode[]
  refreshTokens     RefreshToken[]
  assignedCourses   CourseInstructor[]
  enrollments       Enrollment[]

  @@index([role, status])
}

model VerificationCode {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  purpose   CodePurpose
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int         @default(0)
  createdAt DateTime    @default(now())

  @@index([userId, purpose])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum CourseType {
  COURSE
  WORKSHOP
  CONFERENCE
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnrollmentStatus {
  ENROLLED
  CANCELLED
}

model Course {
  id          String       @id @default(uuid())
  title       String
  description String
  type        CourseType   @default(COURSE)
  category    String
  venue       String
  startsAt    DateTime
  endsAt      DateTime
  capacity    Int
  status      CourseStatus @default(DRAFT)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  instructors CourseInstructor[]
  enrollments Enrollment[]

  @@index([status, startsAt])
  @@index([category])
}

model CourseInstructor {
  courseId     String
  instructorId String
  course       Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructor   User   @relation(fields: [instructorId], references: [id], onDelete: Restrict)

  @@id([courseId, instructorId])
  @@index([instructorId])
}

model Enrollment {
  id          String           @id @default(uuid())
  courseId    String
  studentId   String
  status      EnrollmentStatus @default(ENROLLED)
  enrolledAt  DateTime         @default(now())
  cancelledAt DateTime?
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  student     User             @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([courseId, studentId])
  @@index([studentId, status])
  @@index([courseId, status])
}
