# Base de datos
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/capacitaciones

# JWT (usar valores largos y aleatorios, distintos entre si)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# App
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# Google OAuth (prod: https://gestion.universoftsystems.com/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Brevo (si BREVO_API_KEY esta vacio, los correos se imprimen en consola en dev)
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Capacitaciones

# Seed del administrador (ADMIN_PASSWORD es obligatorio para el seed)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
